generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shared Employee model - core employee data
model Employee {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  region        String
  department    String
  role          String
  hireDate      DateTime
  status        String   @default("active") // active, inactive, on_leave
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations to shared data
  incentives    Incentive[]
  performance   Performance[]
}

// Shared Performance model - tracks employee performance metrics
model Performance {
  id            String   @id @default(cuid())
  employeeId    String
  metricsDate   DateTime
  
  // Performance metrics
  payoutsProcessed    Int     @default(0)
  errorCount          Int     @default(0)
  avgProcessingTimeMs Float   @default(0)
  slaCompliance       Float   @default(100) // percentage 0-100
  
  // Quality metrics
  accuracyRate        Float   @default(100)
  delayRate           Float   @default(0)
  
  status              String  @default("active")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([metricsDate])
}

// Shared Incentive model - tracks incentive payouts
model Incentive {
  id               String   @id @default(cuid())
  employeeId       String
  
  // Payout details
  expectedAmount   Float
  actualAmount     Float
  variance         Float?   // calculated: actualAmount - expectedAmount
  variancePercent  Float?   // calculated: (variance / expectedAmount) * 100
  
  // Processing details
  processingTimeMs Int?
  status           String   @default("processed") // pending, processed, failed, reversed
  period           String   // "2026-01", "2026-Q1", etc.
  
  // Error tracking
  hasError         Boolean  @default(false)
  errorType        String?  // "data_issue", "logic_issue", "delay_issue", null if no error
  errorDescription String?
  errorSeverity    String?  // "critical", "high", "medium", "low"
  
  // Timestamps
  processedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([period])
  @@index([hasError])
}
